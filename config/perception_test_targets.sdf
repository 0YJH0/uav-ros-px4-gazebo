<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="perception_test_targets">

    <static>true</static>

    <!-- ===================================================== -->
    <!-- Red wall: directly in front of the initial UAV pose  -->
    <!-- x = +8 m                                             -->
    <!-- ===================================================== -->

    <link name="red_wall">

      <pose>
        8.0 0.0 3.0 0 0 0
      </pose>

      <visual name="red_wall_visual">

        <geometry>
          <box>
            <size>
              0.30 4.00 6.00
            </size>
          </box>
        </geometry>

        <material>

          <ambient>
            1.0 0.0 0.0 1.0
          </ambient>

          <diffuse>
            1.0 0.0 0.0 1.0
          </diffuse>

          <specular>
            0.2 0.2 0.2 1.0
          </specular>

        </material>

      </visual>

      <collision name="red_wall_collision">

        <geometry>
          <box>
            <size>
              0.30 4.00 6.00
            </size>
          </box>
        </geometry>

      </collision>

    </link>


    <!-- ===================================================== -->
    <!-- Green pillar: left / right visual reference           -->
    <!-- ===================================================== -->

    <link name="green_pillar">

      <pose>
        12.0 -5.0 2.0 0 0 0
      </pose>

      <visual name="green_pillar_visual">

        <geometry>
          <box>
            <size>
              1.50 1.50 4.00
            </size>
          </box>
        </geometry>

        <material>

          <ambient>
            0.0 1.0 0.0 1.0
          </ambient>

          <diffuse>
            0.0 1.0 0.0 1.0
          </diffuse>

        </material>

      </visual>

      <collision name="green_pillar_collision">

        <geometry>
          <box>
            <size>
              1.50 1.50 4.00
            </size>
          </box>
        </geometry>

      </collision>

    </link>


    <!-- ===================================================== -->
    <!-- Blue pillar                                           -->
    <!-- ===================================================== -->

    <link name="blue_pillar">

      <pose>
        12.0 5.0 2.0 0 0 0
      </pose>

      <visual name="blue_pillar_visual">

        <geometry>
          <box>
            <size>
              1.50 1.50 4.00
            </size>
          </box>
        </geometry>

        <material>

          <ambient>
            0.0 0.0 1.0 1.0
          </ambient>

          <diffuse>
            0.0 0.0 1.0 1.0
          </diffuse>

        </material>

      </visual>

      <collision name="blue_pillar_collision">

        <geometry>
          <box>
            <size>
              1.50 1.50 4.00
            </size>
          </box>
        </geometry>

      </collision>

    </link>

  </model>

</sdf>
