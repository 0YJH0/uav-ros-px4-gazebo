<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="red_target_board">

    <static>true</static>

    <link name="target_link">

      <!--
        Gazebo world frame:
        x = forward
        y = lateral
        z = up

        Target:
        x = 10 m
        y = 0 m
        center height = 2.5 m
      -->

      <pose>
        10.0 0.0 2.5 0 0 0
      </pose>

      <visual name="target_visual">

        <geometry>
          <box>
            <!-- thickness / width / height -->
            <size>
              0.10 1.50 1.50
            </size>
          </box>
        </geometry>

        <material>

          <ambient>
            1.0 0.0 0.0 1.0
          </ambient>

          <diffuse>
            1.0 0.0 0.0 1.0
          </diffuse>

          <specular>
            0.1 0.1 0.1 1.0
          </specular>

        </material>

      </visual>

      <collision name="target_collision">

        <geometry>
          <box>
            <size>
              0.10 1.50 1.50
            </size>
          </box>
        </geometry>

      </collision>

    </link>

  </model>

</sdf>