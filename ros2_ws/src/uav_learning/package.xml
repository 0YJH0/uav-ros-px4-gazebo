<?xml version="1.0"?>

<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>uav_learning</name>

  <version>0.0.0</version>

  <description>
    ROS 2 UAV autonomous perception,
    PX4 Offboard control and Gazebo mission simulation.
  </description>

  <maintainer email="yjh@todo.todo">
    yjh
  </maintainer>

  <license>
    Apache-2.0
  </license>

  <buildtool_depend>
    ament_python
  </buildtool_depend>

  <depend>
    rclpy
  </depend>

  <depend>
    std_msgs
  </depend>

  <depend>
    sensor_msgs
  </depend>

  <depend>
    cv_bridge
  </depend>

  <depend>
    px4_msgs
  </depend>

  <depend>
    uav_interfaces
  </depend>

  <exec_depend>
    ros_gz_bridge
  </exec_depend>

  <exec_depend>
    ros_gz_image
  </exec_depend>

  <exec_depend>
    launch
  </exec_depend>

  <exec_depend>
    launch_ros
  </exec_depend>

  <test_depend>
    ament_flake8
  </test_depend>

  <test_depend>
    ament_pep257
  </test_depend>

  <test_depend>
    python3-pytest
  </test_depend>

  <export>

    <build_type>
      ament_python
    </build_type>

  </export>

</package>