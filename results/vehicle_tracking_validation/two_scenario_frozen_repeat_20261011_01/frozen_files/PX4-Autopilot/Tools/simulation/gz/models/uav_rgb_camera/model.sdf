<?xml version="1.0" encoding="UTF-8"?>

<sdf version="1.9">

  <model name="uav_rgb_camera">

    <pose>0 0 0 0 0 0</pose>

    <self_collide>false</self_collide>

    <static>false</static>


    <link name="camera_link">

      <!-- ================================================== -->
      <!-- Camera physical properties                         -->
      <!-- ================================================== -->

      <inertial>

        <mass>0.03</mass>

        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>

          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>

          <izz>0.00001</izz>
        </inertia>

      </inertial>


      <!-- ================================================== -->
      <!-- Simple camera body                                 -->
      <!-- ================================================== -->

      <visual name="camera_visual">

        <geometry>

          <box>
            <size>0.05 0.08 0.03</size>
          </box>

        </geometry>

        <material>

          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.08 0.08 0.08 1.0</diffuse>

        </material>

      </visual>


      <collision name="camera_collision">

        <geometry>

          <box>
            <size>0.05 0.08 0.03</size>
          </box>

        </geometry>

      </collision>


      <!-- ================================================== -->
      <!-- RGB Camera                                         -->
      <!-- ================================================== -->

      <sensor name="IMX214" type="camera">

        <gz_frame_id>
          camera_link
        </gz_frame_id>

        <!-- Camera optical axis points forward -->
        <pose>
          0 0 0 0 0 0
        </pose>

        <camera>

          <!-- About 69 degrees -->
          <horizontal_fov>
            1.204
          </horizontal_fov>

          <image>

            <width>
              960
            </width>

            <height>
              540
            </height>

          </image>

          <clip>

            <near>
              0.1
            </near>

            <far>
              100.0
            </far>

          </clip>

        </camera>


        <always_on>
          true
        </always_on>

        <!-- Lower rendering load -->
        <update_rate>
          20
        </update_rate>

        <!-- Disable extra Gazebo sensor visualization -->
        <visualize>
          false
        </visualize>

      </sensor>


      <gravity>true</gravity>

    </link>

  </model>

</sdf>